{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // `_tag` is Effect's own discriminant on a tagged error — `Data.TaggedError`
    // writes it and every `catchTag`/`match` in the api and the sdk reads it, so
    // it is not this repo's naming to change. `__BUILD_DATE__` is the same shape
    // one layer down: Vite's `define` convention for a compile-time constant,
    // declared once in `vite-env.d.ts`.
    "no-underscore-dangle": ["error", { "allow": ["_tag", "__BUILD_DATE__"] }],
    // Both rules ask for `toSorted`/`toReversed`, which are ES2023. This repo
    // compiles to ES2022 (`tsconfig.base.json`, and `packages/web` restates the
    // `lib` explicitly), so the replacement they name does not typecheck — and
    // raising the language level is a browser-support decision, not a lint fix.
    // `oxlint-oxfmt-config.test.ts` holds the two together: move the target and
    // the guard asks for these back.
    "unicorn/no-array-sort": "off",
    // Same reason, the other method: `toReversed` is ES2023 too.
    "unicorn/no-array-reverse": "off",
    // The next two are the rules this repo has always allowed. The decision
    // predates the ox toolchain — the config that carried it was deleted at the
    // cutover (issue #138), so each reason is re-homed here rather than lost
    // with it.
    //
    // `any` is how the app types the edges it does not own: a jsdom stub, a
    // recharts payload, a JSON blob on its way into a schema. The rule's fix at
    // those sites is a cast that says less than the code it replaces.
    "typescript/no-explicit-any": "off",
    // An assertion is how the app reads a lookup it has just proved non-empty —
    // the index into a list it filtered, the match group a regex it wrote
    // guarantees. The alternative is a branch that cannot be taken and cannot
    // be tested.
    "typescript/no-non-null-assertion": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Input", "Select", "Textarea", "Checkbox"]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "packages/web/src/styles/gousse",
    "packages/web/src/components/ui/sidebar.tsx",
    "packages/web/src/components/ui/app-shell.tsx",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "packages/api/openapi.json",
    "graphify-out"
  ]
}
