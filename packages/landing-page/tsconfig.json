{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2023",
    /* `DOM` is here for `@types/react`, which is written against it — not
       because anything ships to a browser. The preview renderer (issue #145)
       runs React in Node at build time and the built page carries no script;
       the tests under `src/preview/` are what hold that. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "jsx": "react-jsx",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
