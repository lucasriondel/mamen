{
	"name": "@mamen/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*"
	},
	"scripts": {
		"dev": "mkdir -p ../../logs && bun --watch src/index.ts 2>&1 | tee ../../logs/server.log",
		"start": "bun src/index.ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "bun run openapi:check && vitest run",
		"test:watch": "vitest",
		"emit-openapi": "bun run scripts/emit-openapi.ts",
		"openapi:check": "bun run scripts/emit-openapi.ts --check"
	},
	"dependencies": {
		"@effect/platform": "0.96.2",
		"@effect/platform-bun": "0.90.0",
		"@effect/sql": "0.51.1",
		"@effect/sql-sqlite-bun": "0.52.0",
		"@mamen/shared": "workspace:*",
		"effect": "3.21.4"
	},
	"devDependencies": {
		"@effect/platform-node": "0.107.0",
		"@effect/sql-sqlite-node": "0.52.0",
		"@effect/vitest": "0.29.0",
		"@vitest/coverage-v8": "3.2.4",
		"bun-types": "^1.3.9",
		"vitest": "3.2.4"
	}
}
