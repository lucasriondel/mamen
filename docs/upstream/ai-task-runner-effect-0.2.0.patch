+++ b/test/runner-document.test.ts
@@ -0,0 +1,196 @@
+import { describe, expect, test } from "bun:test"
+
+import { Effect, Redacted } from "effect"
+
+import { makeTaskRunner } from "../src/runner.ts"
+import type { TaskTable } from "../src/task.ts"
+import {
+	claudeCodeRecording,
+	claudeCodeUnused,
+	onlyCall,
+	passthroughCodec,
+	recordingGenerate,
+	refusingCodec,
+} from "./support.ts"
+
+const PDF_BYTES = new Uint8Array([0x25, 0x50, 0x44, 0x46, 0x2d, 0x31, 0x2e, 0x37])
+
+/**
+ * Two rows over one table: one contributes a document, one is the text-only
+ * task that must keep behaving exactly as it did before this feature.
+ *
+ * A row has one `Input`, so both columns are written against the whole of it
+ * even where each reads a different half — the CLI names the path its `Read`
+ * tool will open, the hosted column hands over the bytes.
+ */
+type Statement = { path: string; bytes: Uint8Array }
+
+const TASKS = {
+	"extract-pdf": {
+		output: passthroughCodec<{ rows: number }>({ type: "object" }),
+		cliPrompt: (input: Statement) => `Read the statement at ${input.path}`,
+		hostedPrompt: (input: Statement) => ({
+			text: `Extract every operation. (${input.path})`,
+			document: { data: input.bytes, mediaType: "application/pdf" },
+		}),
+		hostedInstruction: "Return the operations as JSON.",
+		allowedTools: ["Read"],
+	},
+	summarize: {
+		output: passthroughCodec<{ text: string }>({ type: "object" }),
+		cliPrompt: (input: { text: string }) => `Summarize:\n${input.text}`,
+		hostedPrompt: (input: { text: string }) => `Summarize:\n${input.text}`,
+		hostedInstruction: "Return the summary as JSON.",
+		allowedTools: [],
+	},
+} as const satisfies TaskTable
+
+const hostedDeps = (key: string | null) => ({
+	resolve: () => Effect.succeed({ provider: "anthropic" as const, model: "claude-haiku-4-5" }),
+	credential: () => Effect.succeed(key === null ? null : Redacted.make(key)),
+})
+
+describe("a document-bearing task", () => {
+	test("reaches the seam with the right bytes and media type", async () => {
+		const { calls, generate } = recordingGenerate({ rows: 3 })
+		const runner = makeTaskRunner(TASKS, hostedDeps("sk-ant-key"), {
+			generateHosted: generate,
+		})
+
+		const result = await Effect.runPromise(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		const call = onlyCall(calls)
+		expect(call.document).toBeDefined()
+		expect(call.document?.mediaType).toBe("application/pdf")
+		expect(call.document?.data).toEqual(PDF_BYTES)
+		expect(result.output).toEqual({ rows: 3 })
+	})
+
+	test("still sends the hosted prompt as the system turn and the instruction as the prompt", async () => {
+		const { calls, generate } = recordingGenerate({ rows: 1 })
+		const runner = makeTaskRunner(TASKS, hostedDeps("sk-ant-key"), {
+			generateHosted: generate,
+		})
+
+		await Effect.runPromise(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		const call = onlyCall(calls)
+		expect(call.system).toBe("Extract every operation. (/tmp/s.pdf)")
+		expect(call.prompt).toBe("Return the operations as JSON.")
+		// The CLI column never crosses to a vendor.
+		expect(call.system).not.toContain("Read the statement")
+	})
+
+	test("does not fall back when the credential is gone — and never calls the vendor", async () => {
+		const { calls, generate } = recordingGenerate()
+		const runner = makeTaskRunner(TASKS, hostedDeps(null), {
+			generateHosted: generate,
+		})
+
+		const exit = await Effect.runPromiseExit(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		expect(exit._tag).toBe("Failure")
+		expect(String(exit)).toContain("TaskNotRunnableError")
+		expect(calls).toHaveLength(0)
+	})
+
+	test("scrubs the key from a vendor error that quotes it", async () => {
+		const key = "sk-ant-secret-key"
+		const runner = makeTaskRunner(TASKS, hostedDeps(key), {
+			generateHosted: async () => {
+				throw new Error(`401 from vendor using ${key}`)
+			},
+		})
+
+		const exit = await Effect.runPromiseExit(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		const rendered = JSON.stringify(exit)
+		expect(rendered).toContain("HostedApiError")
+		expect(rendered).toContain("«redacted»")
+		expect(rendered).not.toContain(key)
+	})
+
+	test("a payload the codec refuses is a schema error, not a vendor error", async () => {
+		const table = {
+			"extract-pdf": {
+				...TASKS["extract-pdf"],
+				output: refusingCodec<{ rows: number }>("bad shape"),
+			},
+		} as const satisfies TaskTable
+
+		const runner = makeTaskRunner(table, hostedDeps("sk-ant-key"), {
+			generateHosted: async () => ({ nope: true }),
+		})
+
+		const exit = await Effect.runPromiseExit(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		expect(String(exit)).toContain("TaskSchemaError")
+	})
+})
+
+describe("the text-only path is untouched", () => {
+	test("a task whose hosted prompt is a plain string attaches no document", async () => {
+		const { calls, generate } = recordingGenerate({ text: "done" })
+		const runner = makeTaskRunner(TASKS, hostedDeps("sk-ant-key"), {
+			generateHosted: generate,
+		})
+
+		await Effect.runPromise(
+			runner.run("summarize", { text: "hello" }).pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		const call = onlyCall(calls)
+		expect(call.document).toBeUndefined()
+		expect(call.system).toBe("Summarize:\nhello")
+		expect(call.prompt).toBe("Return the summary as JSON.")
+		expect(call.modelId).toBe("claude-haiku-4-5")
+		expect(call.apiKey).toBe("sk-ant-key")
+	})
+})
+
+describe("the CLI branch is unaffected", () => {
+	test("a document-bearing task on claude-code sends its CLI prompt and no document", async () => {
+		const { calls, layer } = claudeCodeRecording({
+			object: { rows: 2 },
+			sessionId: "sess-1",
+			model: "claude-haiku-4-5",
+		})
+		const runner = makeTaskRunner(TASKS, {
+			resolve: () =>
+				Effect.succeed({ provider: "claude-code" as const, model: "claude-haiku-4-5" }),
+			credential: () => Effect.die("credential must not be asked for the CLI branch"),
+		})
+
+		const result = await Effect.runPromise(
+			runner
+				.run("extract-pdf", { path: "/tmp/s.pdf", bytes: PDF_BYTES })
+				.pipe(Effect.provide(layer)),
+		)
+
+		const options = onlyCall(calls) as { prompt: string; allowedTools: readonly string[] }
+		expect(options.prompt).toBe("Read the statement at /tmp/s.pdf")
+		expect(options.allowedTools).toEqual(["Read"])
+		expect(options).not.toHaveProperty("document")
+		expect(result.runId).toBe("sess-1")
+	})
+})
