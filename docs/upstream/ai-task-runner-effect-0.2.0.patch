@@ -0,0 +1,95 @@
+import { describe, expect, test } from "bun:test"
+
+import { Effect, Redacted } from "effect"
+
+import type { HostedGenerate } from "../src/hosted.ts"
+import { makeTaskRunner } from "../src/runner.ts"
+import type { TaskTable } from "../src/task.ts"
+import { claudeCodeUnused, passthroughCodec } from "./support.ts"
+
+/**
+ * The seam's whole point is that a consumer can fake it. Two properties are
+ * asserted here by the compiler as much as at runtime: a fake written before
+ * documents existed still satisfies `HostedGenerate`, and a fake that wants to
+ * see a document needs one extra line to do it.
+ */
+
+/** Written against 0.1.0's argument shape — no mention of a document. */
+const legacyFake: HostedGenerate = async (args: {
+	readonly vendor: string
+	readonly modelId: string
+	readonly apiKey: string
+	readonly system: string
+	readonly prompt: string
+	readonly jsonSchema: unknown
+}) => ({ saw: args.system })
+
+const TASKS = {
+	summarize: {
+		output: passthroughCodec<{ saw: string }>(),
+		cliPrompt: (input: { text: string }) => input.text,
+		hostedPrompt: (input: { text: string }) => input.text,
+		hostedInstruction: "Return JSON.",
+		allowedTools: [],
+	},
+} as const satisfies TaskTable
+
+describe("the widened seam stays fakeable", () => {
+	test("a fake written against the pre-document signature still runs", async () => {
+		const runner = makeTaskRunner(
+			TASKS,
+			{
+				resolve: () =>
+					Effect.succeed({ provider: "openai" as const, model: "gpt-4.1-mini" }),
+				credential: () => Effect.succeed(Redacted.make("sk-openai")),
+			},
+			{ generateHosted: legacyFake },
+		)
+
+		const result = await Effect.runPromise(
+			runner.run("summarize", { text: "hi" }).pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		expect(result.output).toEqual({ saw: "hi" })
+		expect(result.model).toBe("gpt-4.1-mini")
+		expect(result.runId).toStartWith("hosted-openai-")
+	})
+
+	test("asserting a document is one property on the recorded args", async () => {
+		// The entire fake, as a consumer would write it.
+		let seen: { data: Uint8Array; mediaType: string } | undefined
+		const fake: HostedGenerate = async (args) => ((seen = args.document), { saw: "" })
+
+		const table = {
+			"extract-pdf": {
+				output: passthroughCodec<{ saw: string }>(),
+				cliPrompt: (input: { bytes: Uint8Array }) => `${input.bytes.length} bytes`,
+				hostedPrompt: (input: { bytes: Uint8Array }) => ({
+					text: "Extract it.",
+					document: { data: input.bytes, mediaType: "application/pdf" },
+				}),
+				hostedInstruction: "Return JSON.",
+				allowedTools: [],
+			},
+		} as const satisfies TaskTable
+
+		const runner = makeTaskRunner(
+			table,
+			{
+				resolve: () =>
+					Effect.succeed({ provider: "google" as const, model: "gemini-2.5-flash" }),
+				credential: () => Effect.succeed(Redacted.make("goog-key")),
+			},
+			{ generateHosted: fake },
+		)
+
+		await Effect.runPromise(
+			runner
+				.run("extract-pdf", { bytes: new Uint8Array([9, 9]) })
+				.pipe(Effect.provide(claudeCodeUnused)),
+		)
+
+		expect(seen?.mediaType).toBe("application/pdf")
+		expect(seen?.data).toEqual(new Uint8Array([9, 9]))
+	})
+})
