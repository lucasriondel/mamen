@@ -0,0 +1,74 @@
+import { describe, expect, test } from "bun:test"
+
+import { hostedPromptFields } from "../src/hosted.ts"
+import { hostedTurn } from "../src/prompt.ts"
+
+const BYTES = new Uint8Array([1, 2, 3])
+
+describe("hostedTurn normalizes the two forms a task may return", () => {
+	test("a plain string becomes text with no document", () => {
+		expect(hostedTurn("just text")).toEqual({ text: "just text" })
+		expect(hostedTurn("just text").document).toBeUndefined()
+	})
+
+	test("an object is carried through untouched", () => {
+		const document = { data: BYTES, mediaType: "application/pdf" }
+		expect(hostedTurn({ text: "with a file", document })).toEqual({
+			text: "with a file",
+			document,
+		})
+	})
+})
+
+describe("the ai-sdk call shape", () => {
+	test("text-only keeps the `prompt:` form, exactly as before", () => {
+		const fields = hostedPromptFields({ system: "sys", prompt: "do it" })
+
+		expect(fields).toEqual({ system: "sys", prompt: "do it" })
+		expect(fields).not.toHaveProperty("messages")
+	})
+
+	test("a document moves the call to the `messages:` form with a file part", () => {
+		const fields = hostedPromptFields({
+			system: "sys",
+			prompt: "do it",
+			document: { data: BYTES, mediaType: "application/pdf" },
+		})
+
+		expect(fields).not.toHaveProperty("prompt")
+		expect(fields).toEqual({
+			system: "sys",
+			messages: [
+				{
+					role: "user",
+					content: [
+						{ type: "text", text: "do it" },
+						// `mimeType` is what the pinned ai-sdk calls the media type; a
+						// vendor that received `mediaType` here would see no file at all.
+						{ type: "file", data: BYTES, mimeType: "application/pdf" },
+					],
+				},
+			],
+		})
+	})
+
+	test("the file part rides the same user turn as the instruction, not a turn of its own", () => {
+		const fields = hostedPromptFields({
+			system: "sys",
+			prompt: "do it",
+			document: { data: BYTES, mediaType: "image/png" },
+		})
+
+		const messages = (fields as { messages: Array<{ role: string; content: unknown[] }> })
+			.messages
+		expect(messages).toHaveLength(1)
+		expect(messages[0]?.role).toBe("user")
+		expect(messages[0]?.content).toHaveLength(2)
+	})
+
+	test("an explicitly undefined document is the text-only form", () => {
+		expect(
+			hostedPromptFields({ system: "sys", prompt: "do it", document: undefined }),
+		).toEqual({ system: "sys", prompt: "do it" })
+	})
+})
