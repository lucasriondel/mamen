@@ -0,0 +1,60 @@
+import { Effect, Layer } from "effect"
+
+import { ClaudeCode, type ObjectCodec } from "claude-code-effect"
+
+import type { HostedGenerate } from "../src/hosted.ts"
+
+/** A codec that hands back whatever the transport gave it. */
+export const passthroughCodec = <A>(
+	jsonSchema: unknown = { type: "object" },
+): ObjectCodec<A> => ({
+	jsonSchema,
+	decode: (payload) => Effect.succeed(payload as A),
+})
+
+/** A codec that always refuses, for the `TaskSchemaError` path. */
+export const refusingCodec = <A>(issues: unknown): ObjectCodec<A> => ({
+	jsonSchema: { type: "object" },
+	decode: () => Effect.fail(issues),
+})
+
+/**
+ * The whole hosted fake, which is the point of the seam: four lines, and the
+ * recorded args are what a test asserts against.
+ */
+export const recordingGenerate = (payload: unknown = { ok: true }) => {
+	const calls: Parameters<HostedGenerate>[0][] = []
+	const generate: HostedGenerate = async (args) => (calls.push(args), payload)
+	return { calls, generate }
+}
+
+/** The first recorded call, or a failed assertion's worth of noise. */
+export const onlyCall = <T>(calls: readonly T[]): T => {
+	if (calls.length !== 1) throw new Error(`expected 1 call, got ${calls.length}`)
+	return calls[0] as T
+}
+
+/**
+ * A `ClaudeCode` that fails loudly if the CLI branch is entered. Hosted runs
+ * still need the tag in context; reaching for it is the bug.
+ */
+export const claudeCodeUnused = Layer.succeed(ClaudeCode, {
+	generateText: () => Effect.die("CLI transport must not run"),
+	generateObject: () => Effect.die("CLI transport must not run"),
+} as unknown as ClaudeCode["Type"])
+
+/** A `ClaudeCode` that records the options the CLI branch built. */
+export const claudeCodeRecording = (result: {
+	object: unknown
+	sessionId: string
+	model: string
+}) => {
+	const calls: unknown[] = []
+	const layer = Layer.succeed(ClaudeCode, {
+		generateText: () => Effect.die("generateText must not run"),
+		generateObject: (_output: unknown, options: unknown) => (
+			calls.push(options), Effect.succeed(result)
+		),
+	} as unknown as ClaudeCode["Type"])
+	return { calls, layer }
+}
