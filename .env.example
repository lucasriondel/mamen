# Environment for the self-hosted `docker compose up --build` (issue #140).
#
# Copy this file to `.env` beside docker-compose.yml and fill it in; compose
# reads `.env` automatically. `.env` is gitignored and this file is not, which
# is why nothing here carries a value.
#
# Nothing below is needed to start the app: with an empty `.env` it comes up,
# imports CSV statements and serves the whole UI. Each variable turns on one
# thing, or moves one.

# The key AI provider credentials are encrypted with (ADR 0011) — 64 hex
# characters, i.e. 32 bytes:
#
#     openssl rand -hex 32
#
# No default, on purpose: a default would be a published encryption key. Unset,
# everything works except storing a credential, which fails with a 500.
#
# Set it once and KEEP IT STABLE. Changing it re-encrypts nothing — the stored
# credentials simply stop being readable, and each has to be pasted again. Back
# it up somewhere other than the data volume: the key and the database together
# are plaintext.
TOKEN_ENCRYPTION_KEY=

# The Claude Code token that PDF import runs on is NOT an environment variable.
# It is a credential pasted into the app's Settings page (`claude setup-token`
# mints it), stored encrypted with the key above. A fresh install has none, and
# nothing but PDF import notices until one is pasted.

# Publishable logo.dev key (`pk_…`) backing issuer Logo search. Optional, and
# not a secret — logo.dev designs it to appear in `<img>` tags. Unset, the
# feature reports itself unconfigured and refuses rather than failing at the
# API. See docs/operations/logo-search-setup.md.
LOGODEV_TOKEN=

# Host port the app is published on: http://localhost:<WEB_PORT>/app/. The API
# is not published on any port — it is reachable only through this one.
# WEB_PORT=8080
