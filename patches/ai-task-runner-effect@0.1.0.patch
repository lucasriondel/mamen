+/**
+ * What a task contributes to the hosted turn.
+ *
+ * The hosted transport used to take a `string` and nothing else, so a task
+ * whose input *is* a file — a scanned statement, a contract — had no way to
+ * hand that file over: it could only describe it. The CLI transport never had
+ * the problem, because it has tools and a filesystem and the prompt can name a
+ * path. A vendor over HTTP has neither, so the bytes have to travel.
+ *
+ * A task therefore returns either a `string` (what every text-only task already
+ * returns, unchanged and still the common case) or a {@link HostedPrompt}, the
+ * same text with a document beside it.
+ */
+/**
+ * The one place the two forms become one. Written here rather than at the
+ * transport so the widening is a single named function with a single test,
+ * and so a task's builder is called exactly once per run.
+ */
+export const hostedTurn = (built) => typeof built === "string" ? { text: built } : built;
