index 0000000..75cab08
--- /dev/null
+++ b/dist/prompt.d.ts
@@ -0,0 +1,47 @@
+/**
+ * What a task contributes to the hosted turn.
+ *
+ * The hosted transport used to take a `string` and nothing else, so a task
+ * whose input *is* a file — a scanned statement, a contract — had no way to
+ * hand that file over: it could only describe it. The CLI transport never had
+ * the problem, because it has tools and a filesystem and the prompt can name a
+ * path. A vendor over HTTP has neither, so the bytes have to travel.
+ *
+ * A task therefore returns either a `string` (what every text-only task already
+ * returns, unchanged and still the common case) or a {@link HostedPrompt}, the
+ * same text with a document beside it.
+ */
+/**
+ * One document attached to a task's hosted turn.
+ *
+ * `data` is the bytes, deliberately as a `Uint8Array` and not a base64 string:
+ * one representation means "the right bytes" is a single unambiguous thing for
+ * a test to assert, and the encoding a vendor wants is the transport's business
+ * rather than the task's. `mediaType` is the IANA type (`application/pdf`), the
+ * name the current ai-sdk uses; the transport maps it onto whatever field the
+ * pinned SDK version spells it as.
+ */
+export interface TaskDocument {
+    readonly data: Uint8Array;
+    readonly mediaType: string;
+}
+/** A hosted turn that carries a document beside its text. */
+export interface HostedPrompt {
+    readonly text: string;
+    readonly document: TaskDocument;
+}
+/**
+ * What a task's `hostedPrompt` may return. `string` is listed first because it
+ * is what a task that has nothing to attach still returns, and what every
+ * existing table returns without being touched.
+ */
+export type HostedPromptBuilt = string | HostedPrompt;
+/**
+ * The one place the two forms become one. Written here rather than at the
+ * transport so the widening is a single named function with a single test,
+ * and so a task's builder is called exactly once per run.
+ */
+export declare const hostedTurn: (built: HostedPromptBuilt) => {
+    readonly text: string;
+    readonly document?: TaskDocument;
+};
